FACEFIND_PRIMARY.ENV="local"

FACEFIND_SERVER.PORT="8080"
FACEFIND_SERVER.READ_TIMEOUT="30"
FACEFIND_SERVER.WRITE_TIMEOUT="30"
FACEFIND_SERVER.IDLE_TIMEOUT="60"
FACEFIND_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

FACEFIND_DATABASE.HOST="localhost"
FACEFIND_DATABASE.PORT="5432"
FACEFIND_DATABASE.USER="postgres"
FACEFIND_DATABASE.PASSWORD=""
FACEFIND_DATABASE.NAME="facefind"
FACEFIND_DATABASE.SSL_MODE="disable"

FACEFIND_DATABASE_MIN_CONNS=2
FACEFIND_DATABASE_MAX_CONNS=20
FACEFIND_DATABASE_CONN_MAX_LIFETIME=1h
FACEFIND_DATABASE_CONN_MAX_IDLE_TIME=30m

# FACEFIND_DATABASE.MAX_OPEN_CONNS="25"
# FACEFIND_DATABASE.MAX_IDLE_CONNS="25"
# FACEFIND_DATABASE.CONN_MAX_LIFETIME="300"
# FACEFIND_DATABASE.CONN_MAX_IDLE_TIME="300"

FACEFIND_AUTH.SECRET_KEY="secret"

FACEFIND_INTEGRATION.RESEND_API_KEY="resend_key"

FACEFIND_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
FACEFIND_OBSERVABILITY.SERVICE_NAME="facefind"
FACEFIND_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
FACEFIND_OBSERVABILITY.LOGGING.LEVEL="debug"
FACEFIND_OBSERVABILITY.LOGGING.FORMAT="console"
FACEFIND_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
FACEFIND_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FACEFIND_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
FACEFIND_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
FACEFIND_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
FACEFIND_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
FACEFIND_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
FACEFIND_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
FACEFIND_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"