GO_BACKEND_BOILERPLATE_PRIMARY.ENV="local"

GO_BACKEND_BOILERPLATE_SERVER.PORT="8080"
GO_BACKEND_BOILERPLATE_SERVER.READ_TIMEOUT="30"
GO_BACKEND_BOILERPLATE_SERVER.WRITE_TIMEOUT="30"
GO_BACKEND_BOILERPLATE_SERVER.IDLE_TIMEOUT="60"
GO_BACKEND_BOILERPLATE_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

GO_BACKEND_BOILERPLATE_DATABASE.HOST="localhost"
GO_BACKEND_BOILERPLATE_DATABASE.PORT="5432"
GO_BACKEND_BOILERPLATE_DATABASE.USER="postgres"
GO_BACKEND_BOILERPLATE_DATABASE.PASSWORD=""
GO_BACKEND_BOILERPLATE_DATABASE.NAME="GO_BACKEND_BOILERPLATE"
GO_BACKEND_BOILERPLATE_DATABASE.SSL_MODE="disable"
GO_BACKEND_BOILERPLATE_DATABASE.MAX_OPEN_CONNS="25"
GO_BACKEND_BOILERPLATE_DATABASE.MAX_IDLE_CONNS="25"
GO_BACKEND_BOILERPLATE_DATABASE.CONN_MAX_LIFETIME="300"
GO_BACKEND_BOILERPLATE_DATABASE.CONN_MAX_IDLE_TIME="300"

GO_BACKEND_BOILERPLATE_AUTH.SECRET_KEY="secret"

GO_BACKEND_BOILERPLATE_INTEGRATION.RESEND_API_KEY="resend_key"

GO_BACKEND_BOILERPLATE_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
GO_BACKEND_BOILERPLATE_OBSERVABILITY.SERVICE_NAME="GO_BACKEND_BOILERPLATE"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
GO_BACKEND_BOILERPLATE_OBSERVABILITY.LOGGING.LEVEL="debug"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.LOGGING.FORMAT="console"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
GO_BACKEND_BOILERPLATE_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
GO_BACKEND_BOILERPLATE_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
GO_BACKEND_BOILERPLATE_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"